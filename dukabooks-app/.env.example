# Copy to .env and fill in. Read by the Nitro server only — never exposed to the browser.
NUXT_GPT_PLATFORM_BASE_URL=https://api.gpt-core.com
NUXT_GPT_PLATFORM_API_KEY=sk_app_replace_me
NUXT_GPT_PLATFORM_WORKSPACE_ID=ws_replace_me
# Agent the "Ask AI" chat threads are bound to (create one with client.agents.create)
NUXT_GPT_PLATFORM_AGENT_ID=agt_replace_me
# Extraction result the Dashboard/Invoices screens query (rows of extracted invoices)
NUXT_GPT_PLATFORM_INVOICE_RESULT_ID=result_replace_me
