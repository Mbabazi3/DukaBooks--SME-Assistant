# Copy to .env and fill in. Read by the Nitro server only — never sent to the browser.
GPT_PLATFORM_APP_ID=your-app-id
GPT_PLATFORM_APP_KEY=sk_app_replace_me
# Used for the server's SDK calls (falls back to GPT_PLATFORM_APP_KEY if empty)
GPT_PLATFORM_APP_SERVER_KEY=sk_srv_replace_me
GPT_PLATFORM_BASE_URL=https://staging.api.gpt-core.com
GPT_PLATFORM_WORKSPACE_ID=ws_duka_001

# Optional
# Agent the "Ask AI" chat threads are bound to (platform default if empty)
GPT_PLATFORM_AGENT_ID=
# Extraction result the Dashboard/Invoices screens query (those screens show a config error until set)
GPT_PLATFORM_INVOICE_RESULT_ID=
